// src/config.h.example
// Copy to src/config.h and fill in your values. config.h is gitignored.
#pragma once

// WiFi
#define WIFI_SSID            "your-ssid"
#define WIFI_PASS            "your-pass"

// Axiom
#define AXIOM_QUERY_URL      "https://api.axiom.co/v1/datasets/_apl?format=legacy"
#define AXIOM_TOKEN          "xaat-your-token"
#define AXIOM_APL_QUERY      "['rocry'] | where ['type'] == 'rcpaper_page' and _time > ago(1h) | summarize arg_max(_time, ['order'], ['layout_json'], ['data_ts']) by ['id'] | project ['id'], ['order'], ['layout_json'], ['data_ts'] | order by ['order'] asc nulls last, ['id'] asc"

// Behavior
#define FETCH_INTERVAL_SEC   900   // 15 min
#define ROTATE_INTERVAL_SEC  300   //  5 min

// Local time zone, in POSIX TZ string format. The footer formats HH:MM in
// this zone after NTP sync. Examples:
//   "CST-8"                       — China Standard Time
//   "PST8PDT,M3.2.0,M11.1.0"      — US Pacific with DST
//   "GMT0BST,M3.5.0/1,M10.5.0"    — UK
#define LOCAL_TZ             "UTC0"

// TLS root CA for api.axiom.co (ISRG Root X1 — Let's Encrypt chain).
// Paste the PEM here; mirrors the eInkClaude pattern.
static const char AXIOM_ROOT_CA[] = R"(-----BEGIN CERTIFICATE-----
...paste the PEM here...
-----END CERTIFICATE-----
)";
