MACRO(SET_BUILD_TIMESTAMP OUTPUT_VAR FORMAT)
    string(TIMESTAMP TEMP "${FORMAT}")
    IF (${TEMP} STREQUAL "0")
        SET(${OUTPUT_VAR} ${TEMP})
    ELSEIF (${TEMP} STREQUAL "00")
        SET(${OUTPUT_VAR} "0")
    ELSE()
        string(REGEX REPLACE "^0" "" ${OUTPUT_VAR} "${TEMP}")
    ENDIF()
ENDMACRO()